# Скопируйте этот файл в .env и подставьте свои значения.
# Сгенерировать секрет: python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=замените-на-пароль
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Только для сервера с доменом и HTTPS ---
# DOMAIN=example.ru
# DJANGO_HTTPS=1
# COMPOSE_PROFILES=prod
